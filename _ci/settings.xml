<settings>
    <mirrors>
        <mirror>
            <id>cic-ext-pull-through</id>
            <name>Maven Central</name>
            <url>https://artifacts.hyland.dev/basic/cic-ext-pull-through/maven/</url>
            <mirrorOf>central</mirrorOf>
        </mirror>
    </mirrors>

    <profiles>
        <profile>
            <id>default</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <!-- WhiteSource token -->
                <org.whitesource.orgToken>${env.WHITESOURCE_TOKEN}</org.whitesource.orgToken>
            </properties>
        </profile>
    </profiles>

    <servers>
        <server>
            <id>cic-ext-pull-through</id>
            <username>${env.CLOUDSMITH_USERNAME}</username>
            <password>${env.CLOUDSMITH_API_KEY}</password>
        </server>
        <server>
            <id>alfresco-releases</id>
            <username>${env.CLOUDSMITH_USERNAME}</username>
            <password>${env.CLOUDSMITH_API_KEY}</password>
        </server>
    </servers>
</settings>
